{
  "name": "medical-ai-diagnosis-frontend",
  "version": "1.0.0",
  "description": "Sistema de Diagnóstico Médico con IA - Frontend Vue.js",
  "author": "Richard Guamán, José Baculima - Universidad de Cuenca",
  "private": true,
  "type": "module",
  "keywords": [
    "medical-ai",
    "diagnosis",
    "vue3",
    "vuetify",
    "unet3d",
    "medical-imaging",
    "dicom",
    "brain-tumor-detection"
  ],
  "scripts": {
    "dev": "vite --host",
    "serve": "vite --host",
    "start": "vite --host",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "preview": "vite preview --host",
    "preview:dist": "vite preview --host --port 4173",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest --coverage",
    "test:unit:watch": "vitest --watch",
    "prepare": "cypress install",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "test:e2e:headless": "start-server-and-test preview http://localhost:4173 'cypress run --e2e --headless'",
    "lint": "eslint . --fix --ext .vue,.js,.jsx,.ts,.tsx",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.ts,.tsx",
    "format": "prettier --write src/ --ignore-path .gitignore",
    "format:check": "prettier --check src/ --ignore-path .gitignore",
    "clean": "rm -rf dist node_modules/.vite",
    "clean:all": "rm -rf dist node_modules node_modules/.vite package-lock.json",
    "deps:update": "npm update",
    "deps:audit": "npm audit",
    "deps:audit:fix": "npm audit fix",
    "medical:dev": "npm run dev",
    "medical:build": "npm run build:production",
    "medical:deploy": "npm run build:production && npm run preview",
    "docker:build": "docker build -t medical-ai-frontend .",
    "docker:run": "docker run -p 3000:80 medical-ai-frontend"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.0.1",
    "@fortawesome/free-solid-svg-icons": "^7.0.1",
    "@fortawesome/vue-fontawesome": "^3.1.2",
    "@heroicons/vue": "^2.2.0",
    "@mdi/font": "^7.4.47",
    "@mdi/js": "^7.4.47",
    "axios": "^1.13.2",
    "chart.js": "^4.5.0",
    "dayjs": "^1.11.13",
    "file-saver": "^2.0.5",
    "gsap": "^3.13.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.1",
    "localforage": "^1.10.0",
    "lodash-es": "^4.17.21",
    "nifti-reader-js": "^0.8.0",
    "pako": "^2.1.0",
    "pinia": "^2.1.7",
    "sass": "^1.89.2",
    "three": "^0.178.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.5.0",
    "vue-toastification": "^2.0.0-rc.5",
    "vuetify": "^3.8.10",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/file-saver": "^2.0.7",
    "@types/lodash-es": "^4.17.12",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/eslint-plugin": "^1.1.39",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "cypress": "^14.2.1",
    "eslint": "^9.38.0",
    "eslint-plugin-cypress": "^4.2.0",
    "eslint-plugin-vue": "~10.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "3.5.3",
    "start-server-and-test": "^2.0.11",
    "vite": "^6.2.4",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vitest": "^3.1.1",
    "vue-eslint-parser": "^10.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/universidad-cuenca/medical-ai-diagnosis-frontend.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/universidad-cuenca/medical-ai-diagnosis-frontend/issues"
  },
  "homepage": "https://medical-ai-diagnosis.ucuenca.edu.ec"
}
