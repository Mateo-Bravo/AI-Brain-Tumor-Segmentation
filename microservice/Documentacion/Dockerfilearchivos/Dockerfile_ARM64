# ==================================================
# Imagen base con CUDA 12.1 y cuDNN 8
# ==================================================
FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04

# ==================================================
# Variables de entorno
# ==================================================
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV RUN_MAIN=true

# ==================================================
# Instalar Python 3.12 y dependencias del sistema
# ==================================================
RUN apt-get update && apt-get install -y \
    software-properties-common \
    curl \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y \
    python3.12 \
    python3.12-dev \
    python3.12-venv \
    gcc \
    g++ \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# ==================================================
# Instalar pip manualmente para Python 3.12
# ==================================================
RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3.12

# ==================================================
# Configurar Python 3.12 como predeterminado
# ==================================================
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1

# ==================================================
# Directorio de trabajo
# ==================================================
WORKDIR /app

# ==================================================
# Instalar dependencias Python
# ==================================================
COPY requirements.txt .
RUN python3.12 -m pip install --upgrade pip setuptools wheel \
    && python3.12 -m pip install --no-cache-dir -r requirements.txt

# ==================================================
# Copiar código fuente
# ==================================================
COPY . .

# ==================================================
# Crear directorios necesarios
# ==================================================
RUN mkdir -p /app/logs /app/uploads /app/temp

# ==================================================
# Exponer puerto
# ==================================================
EXPOSE 3020

# ==================================================
# Health check
# ==================================================
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:3020/health || exit 1

# ==================================================
# Comando de inicio
# ==================================================
CMD ["python3.12", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "3020"]