{
  // Intérprete de Python (usa tu entorno virtual local)
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.pythonPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,

  // Autoformato al guardar usando Black
  "python.formatting.provider": "black",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },

  // Linting (pylint activo, flake8 desactivado)
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": true,
  "python.linting.flake8Enabled": false,

  // Configuración para Jupyter
  "jupyter.notebookFileRoot": "${workspaceFolder}",
  "jupyter.interactiveWindow.mode": "perFile",
  "jupyter.jupyterServerType": "local",

  // Ocultar carpetas que no necesitas ver
  "files.exclude": {
    "**/__pycache__": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.venv": false
  },

  // Soporte para commits semánticos
  "conventionalCommits.scopes": [
    "feature",
    "frontend",
    "backend",
    "security",
    "authentication",
    "database",
    "documentation",
    "bug",
    "hotfix",
    "qa",
    "testing",
    "DevOps",
    "Deployment",
    "storage",
    "machine-learning",
    "ux-ui",
    "Lean_inception",
    "enhancement"
  ]
}
